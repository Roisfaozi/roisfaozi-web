---
import { getCollection } from 'astro:content'

const projects = (await getCollection('projects'))
  .sort((left, right) => left.data.order - right.data.order)
  .filter((project) => project.data.featured)
---
<section class="container mx-auto px-6 md:px-12 2xl:px-24 py-24" id="project">
  <div class="mb-16">
    <h2 class="text-4xl font-bold tracking-tighter text-zinc-50 mb-4">Selected Work</h2>
    <p class="text-lg text-zinc-400">Enterprise-grade architecture & production systems.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 project-grid">
    {projects.map((project, idx) => (
      <div class={`group relative flex flex-col justify-between bg-zinc-900/30 border border-zinc-800/50 rounded-3xl overflow-hidden hover:bg-zinc-900/50 hover:border-zinc-700/50 transition-colors ${idx === 0 ? 'lg:col-span-2 lg:flex-row' : ''}`}>
        
        <div class={`p-8 md:p-12 flex flex-col justify-center ${idx === 0 ? 'lg:w-1/2' : ''}`}>
          <h3 class="text-2xl font-bold text-zinc-100 mb-3">{project.data.title}</h3>
          <p class="text-zinc-400 leading-relaxed mb-8">{project.data.description}</p>
          
          <div class="flex flex-wrap gap-2 mb-8">
            {project.data.technologies.map((tech) => (
              <span class="px-3 py-1 bg-zinc-800 text-zinc-300 text-xs font-mono rounded-full">{tech}</span>
            ))}
          </div>

          <div class="flex gap-4 mt-auto">
            {project.data.links.github && (
              <a href={project.data.links.github} target="_blank" rel="noreferrer" class="text-sm font-medium text-zinc-500 hover:text-zinc-50 transition-colors flex items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                GitHub
              </a>
            )}
          </div>
        </div>

        <div class={`relative overflow-hidden bg-zinc-950 flex items-center justify-center p-8 ${idx === 0 ? 'lg:w-1/2' : 'min-h-[240px]'}`}>
          <img src={project.data.image} alt={project.data.title} class="w-full h-auto object-cover rounded-xl border border-zinc-800 shadow-2xl group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const ctx = gsap.context(() => {
    gsap.fromTo('.project-grid > div',
      { y: 40, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.project-grid',
          start: 'top 80%',
        }
      }
    )
  })
</script>
