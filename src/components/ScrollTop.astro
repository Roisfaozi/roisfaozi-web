---
import { Icon } from 'astro-icon/components'
---
<a
  id="scroll-top"
  href="#home"
  aria-label="Back to top"
  class="hidden 2md:inline-flex items-center justify-center w-11 h-11 rounded-full bg-zinc-900/90 backdrop-blur-md border border-zinc-800 text-zinc-400 hover:text-zinc-50 hover:border-zinc-700 transition-colors fixed right-8 bottom-8 z-40 active:scale-[0.98]"
>
  <Icon name="ph:arrow-up" class="w-5 h-5" />
</a>
