---
---
<section class="container mx-auto px-6 md:px-12 2xl:px-24 py-24" id="about">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-min reveal-section">
    
    <!-- About Me Card -->
    <div class="lg:col-span-2 bg-zinc-900/50 border border-zinc-800/50 rounded-3xl p-8 md:p-12 flex flex-col justify-between">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-50 mb-6">About Me</h2>
      <p class="text-lg text-zinc-400 leading-relaxed max-w-[60ch]">
        I am a dedicated Full-Stack Developer passionate about solving complex real-world problems through clean, efficient, and production-ready code. Based in Indonesia, I have a strong track record of working autonomously in global, cross-timezone remote teams.
      </p>
    </div>

    <!-- AI Workflow Card -->
    <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-3xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 bg-zinc-800 rounded-2xl flex items-center justify-center mb-6 text-zinc-300">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/></svg>
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-2">AI-Assisted Workflow</h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Development approach heavily focused on speed and reliability—leveraging AI-assisted workflows like Cursor AI to maintain high velocity without compromising architectural quality and security.
        </p>
      </div>
    </div>

    <!-- Enterprise Backend -->
    <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-3xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 bg-zinc-800 rounded-2xl flex items-center justify-center mb-6 text-zinc-300">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-2">Enterprise Backend</h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Deep mastery in building high-performance, responsive, and scalable systems using Go (Golang) and Docker.
        </p>
      </div>
    </div>

    <!-- Critical Sectors -->
    <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-3xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 bg-zinc-800 rounded-2xl flex items-center justify-center mb-6 text-zinc-300">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-2">Critical Sectors</h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Experienced in architecting systems with maximum security and reliability, including secure banking workflows and medical data management.
        </p>
      </div>
    </div>

    <!-- Web3 -->
    <div class="bg-zinc-900/50 border border-zinc-800/50 rounded-3xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 bg-zinc-800 rounded-2xl flex items-center justify-center mb-6 text-zinc-300">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-2">Web3 & Blockchain</h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          Actively developing future-proof technology solutions in decentralized ecosystems, focusing on the Solana network and Anchor framework using Rust.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const ctx = gsap.context(() => {
    gsap.fromTo('.reveal-section > div',
      { y: 40, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.reveal-section',
          start: 'top 80%',
        }
      }
    )
  })
</script>
