---
import { Icon } from 'astro-icon/components'
import { impactStats, profile, skillGroups } from '../data/profile'
---
<section class="max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-24" id="about">
  <div class="grid grid-cols-1 md:grid-cols-6 gap-6 reveal-about">
    <div data-reveal class="md:col-span-4 bg-zinc-900/60 border border-zinc-800/70 rounded-2xl p-8 md:p-10 flex flex-col justify-between gap-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-50 mb-5">About</h2>
        <div class="space-y-4 text-base md:text-lg text-zinc-400 leading-relaxed max-w-[65ch]">
          <p>
            Based in {profile.location}, I am a backend-focused Full-Stack Developer shipping production systems in Go, TypeScript, SQL, and Docker for enterprise banking and national healthcare networks.
          </p>
          <p>
            Alongside enterprise systems at PT. Sentuh Digital Teknologi, I contribute upstream to open-source ERP infrastructure and collaborate with distributed engineering teams across India, the UK, Norway, Morocco, and France.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-zinc-800/70">
        {impactStats.map((stat) => (
          <div>
            <p class="text-2xl md:text-3xl font-bold font-mono text-zinc-50 tracking-tight">{stat.value}</p>
            <p class="text-xs text-zinc-400 mt-1 leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div data-reveal class="md:col-span-2 bg-gradient-to-b from-emerald-950/35 to-zinc-900/70 border border-emerald-500/20 rounded-2xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6">
          <Icon name="ph:sparkle" class="w-5 h-5" />
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-3">AI-Assisted Workflow</h3>
        <p class="text-sm text-zinc-300 leading-relaxed">
          Applying Cursor AI workflows, structured technical docs, and automated project scaffolding to maintain high delivery velocity without compromising clean architecture or OWASP security standards.
        </p>
      </div>
    </div>

    <div data-reveal class="md:col-span-3 bg-zinc-950 border border-zinc-800/80 rounded-2xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-200 flex items-center justify-center mb-6">
          <Icon name="ph:cpu" class="w-5 h-5" />
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-3">Enterprise Backend & Real-Time</h3>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-[55ch]">
          Architecting Go services (Chi, pgx, raw SQL), PostgreSQL multi-schema isolation, Redis pub/sub, MQTT hardware telemetry, WebSockets, and Casbin RBAC for air-gapped banking and clinical workflows.
        </p>
      </div>
    </div>

    <div data-reveal class="md:col-span-3 bg-zinc-900/40 border border-zinc-800/70 rounded-2xl p-8 flex flex-col justify-between">
      <div>
        <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-200 flex items-center justify-center mb-6">
          <Icon name="ph:git-pull-request" class="w-5 h-5" />
        </div>
        <h3 class="text-xl font-semibold text-zinc-100 mb-3">Full-Stack Web & Open Source</h3>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-[55ch]">
          Building accessible interfaces in TypeScript, React, Next.js, Vue 3, and Astro, while contributing merged PRs to Carbon Manufacturing ERP across async UI caching, Inngest AI extraction, and isolated storage.
        </p>
      </div>
    </div>

    <div data-reveal class="md:col-span-6 bg-zinc-900/50 border border-zinc-800/70 rounded-2xl p-8">
      <h3 class="text-xl font-semibold text-zinc-100 mb-6">Technical Stack</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {skillGroups.map((group) => (
          <div class="space-y-3">
            <h4 class="text-sm font-semibold text-zinc-200">{group.category}</h4>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
