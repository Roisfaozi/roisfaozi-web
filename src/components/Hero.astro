---
---
<section class="relative min-h-[100dvh] flex items-center pt-24 pb-12 overflow-hidden" id="home">
  <!-- subtle gradient backdrop for dark tech aesthetic -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.1),transparent)] pointer-events-none"></div>
  
  <div class="container mx-auto px-6 md:px-12 2xl:px-24 z-10 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-8 flex flex-col items-start space-y-8 hero-content">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Available for new opportunities
        </div>
        
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter text-zinc-50 leading-[1.1]">
          Rois Faozi.<br />
          <span class="text-zinc-500">Full-Stack Developer.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-zinc-400 max-w-[50ch] leading-relaxed">
          Architecting <strong class="text-zinc-200 font-medium">Enterprise-Scale Backends</strong>, Critical Financial Solutions, & The Future of <strong class="text-zinc-200 font-medium">Web3 Ecosystems</strong>.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a href="#project" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-zinc-100 text-zinc-950 font-semibold hover:bg-white transition-transform active:scale-95">
            View Portfolio
          </a>
          <a href="#contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-transparent border border-zinc-800 text-zinc-300 font-medium hover:bg-zinc-900 transition-colors active:scale-95">
            Get in touch
          </a>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-8 left-6 md:left-12 2xl:left-24 hidden md:block opacity-50 hover:opacity-100 transition-opacity hero-scroll">
    <a href="#about" class="text-xs font-mono uppercase tracking-widest text-zinc-500 flex items-center gap-3 rotate-90 origin-left">
      Scroll
      <span class="w-12 h-[1px] bg-zinc-700"></span>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  
  // Hero reveal animation
  const ctx = gsap.context(() => {
    gsap.fromTo('.hero-content > *', 
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out', delay: 0.2 }
    )
    gsap.fromTo('.hero-scroll',
      { opacity: 0 },
      { opacity: 0.5, duration: 1, delay: 1, ease: 'power2.out'}
    )
  })
</script>
