---
import { profile } from '../data/profile'
---
<section class="relative min-h-[100dvh] flex items-center pt-24 pb-16 overflow-hidden" id="home">
  <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.08),transparent)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 w-full z-10 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 hero-content">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
          {profile.availability}
        </div>

        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter text-zinc-50 leading-[1.05]">
          {profile.name}.<br />
          <span class="text-zinc-400">{profile.role}.</span>
        </h1>

        <p class="text-lg md:text-xl text-zinc-400 max-w-[46ch] leading-relaxed">
          Building high-throughput Go backends, TypeScript web applications, and real-time enterprise systems for banking and healthcare.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="#project"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-zinc-100 text-zinc-950 font-semibold hover:bg-zinc-200 transition-transform active:scale-[0.98] whitespace-nowrap"
          >
            View Portfolio
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-zinc-900/70 border border-zinc-700 text-zinc-100 font-medium hover:bg-zinc-800 transition-colors active:scale-[0.98] whitespace-nowrap"
          >
            Say Hello
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 hero-visual">
        <div class="rounded-2xl border border-zinc-800/80 bg-zinc-950 overflow-hidden aspect-[4/3] lg:aspect-[4/5]">
          <img
            src="/images/hero-system.png"
            alt="Minimalist dark architectural server geometry with subtle emerald light"
            width="960"
            height="1200"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero-content > *', {
      y: 24,
      opacity: 0,
      duration: 0.75,
      stagger: 0.08,
      ease: 'power3.out',
      delay: 0.1,
    })

    gsap.from('.hero-visual', {
      y: 24,
      opacity: 0,
      duration: 0.85,
      ease: 'power3.out',
      delay: 0.2,
    })
  })
</script>
