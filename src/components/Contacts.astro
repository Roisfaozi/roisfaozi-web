---
import { Icon } from 'astro-icon/components'
import { profile } from '../data/profile'
---
<section class="max-w-7xl mx-auto px-6 md:px-12 py-24 border-t border-zinc-800/60" id="contact">
  <div class="flex flex-col items-center justify-center text-center max-w-2xl mx-auto space-y-8 reveal-contact">
    <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-zinc-50">Let's work together.</h2>
    <p class="text-base md:text-lg text-zinc-400 leading-relaxed">
      Open to remote full-stack engineering roles, backend architecture consulting, and technical collaborations. Send an email or connect on GitHub and LinkedIn.
    </p>
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-zinc-100 text-zinc-950 font-semibold hover:bg-zinc-200 transition-transform active:scale-[0.98] text-base md:text-lg whitespace-nowrap"
    >
      Say Hello
    </a>

    <div class="flex flex-wrap items-center justify-center gap-6 pt-2 text-sm text-zinc-400">
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 hover:text-zinc-50 transition-colors"
      >
        <Icon name="ph:github-logo" class="w-4 h-4" />
        GitHub
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 hover:text-zinc-50 transition-colors"
      >
        <Icon name="ph:linkedin-logo" class="w-4 h-4" />
        LinkedIn
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-2 hover:text-zinc-50 transition-colors"
      >
        <Icon name="ph:envelope-simple" class="w-4 h-4" />
        {profile.email}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.reveal-contact > *', {
      y: 24,
      opacity: 0,
      duration: 0.7,
      stagger: 0.08,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.reveal-contact',
        start: 'top 85%',
        once: true,
      },
    })
  })
</script>
