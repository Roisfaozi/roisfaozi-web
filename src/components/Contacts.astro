<section class="container mx-auto px-6 md:px-12 2xl:px-24 py-24 border-t border-zinc-800/50 mt-12" id="contact">
  <div class="flex flex-col items-center justify-center text-center max-w-2xl mx-auto space-y-8 reveal-contact">
    <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-zinc-50">Let's work together.</h2>
    <p class="text-lg text-zinc-400 leading-relaxed">
      Although I'm not currently looking for any new opportunities, my inbox is always open. Whether you have a question or just want to say hi, I'll try my best to get back to you!
    </p>
    <a href="mailto:roisfaozi8@gmail.com" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-zinc-100 text-zinc-950 font-bold hover:bg-white transition-transform active:scale-95 text-lg">
      Say Hello
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const ctx = gsap.context(() => {
    gsap.fromTo('.reveal-contact > *',
      { y: 30, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.reveal-contact',
          start: 'top 85%',
        }
      }
    )
  })
</script>
