---
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import ScrollTop from './ScrollTop.astro'
import { profile, seoMeta } from '../data/profile'
import {
  BLOG_UI_COPY,
  formatBlogDate,
  getArticleSlug,
  getBlogPath,
  type BlogEntry,
  type BlogLang,
} from '../utils/blog'

interface Props {
  lang: BlogLang
  posts: BlogEntry[]
}

const { lang, posts } = Astro.props
const ui = BLOG_UI_COPY[lang]
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || seoMeta.siteUrl

const enBlogUrl = `${siteUrl}/blog`
const idBlogUrl = `${siteUrl}/id/blog`
const currentBlogUrl = lang === 'id' ? idBlogUrl : enBlogUrl
const blogOgImage = `${siteUrl}/og/blog-${lang}.png`

const alternates = [
  { hreflang: 'en', href: enBlogUrl },
  { hreflang: 'id', href: idBlogUrl },
  { hreflang: 'x-default', href: enBlogUrl },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Rois Faozi Portfolio',
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: profile.name,
      url: `${siteUrl}/`,
      image: seoMeta.ogImage,
      jobTitle: 'Full-Stack Developer (Go & TypeScript)',
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentBlogUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: currentBlogUrl,
        },
      ],
    },
    {
      '@type': 'Blog',
      '@id': `${currentBlogUrl}#blog`,
      url: currentBlogUrl,
      name: ui.pageTitle,
      description: ui.pageDescription,
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      isPartOf: { '@id': `${siteUrl}/#website` },
      blogPost: posts.map((post) => {
        const slug = getArticleSlug(post)
        const postUrl = `${siteUrl}${getBlogPath(lang, slug)}`
        const postOg = post.data.ogImage
          ? new URL(post.data.ogImage, `${siteUrl}/`).href
          : `${siteUrl}/og/${lang}/${slug}.png`
        return {
          '@type': 'BlogPosting',
          '@id': `${postUrl}#article`,
          headline: post.data.title,
          description: post.data.description,
          url: postUrl,
          image: postOg,
          datePublished: post.data.publishedAt,
          dateModified: post.data.updatedAt || post.data.publishedAt,
          inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
          author: { '@id': `${siteUrl}/#person` },
          keywords: post.data.tags.join(', '),
        }
      }),
    },
  ],
}
---

<Layout
  title={ui.pageTitle}
  description={ui.pageDescription}
  lang={lang}
  ogType="website"
  ogImage={blogOgImage}
  ogImageAlt={ui.pageTitle}
  alternates={alternates}
  customStructuredData={structuredData}
>
  <Navbar />

  <main id="main-content" class="flex-1 pt-28 md:pt-36 pb-24">
    <section class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-10 border-b border-zinc-800/80">
        <div class="max-w-2xl">
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-50 leading-[1.08]">
            {ui.heading}
          </h1>
          <p class="mt-4 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-[62ch]">
            {ui.subheading}
          </p>
        </div>

        <div class="flex items-center gap-3 self-start lg:self-end shrink-0">
          <nav
            aria-label={ui.languageLabel}
            class="inline-flex items-center p-1 rounded-full bg-zinc-900 border border-zinc-800"
          >
            <a
              href="/blog"
              data-lang-switch="en"
              aria-current={lang === 'en' ? 'page' : undefined}
              aria-label="EN - English"
              class:list={[
                'inline-flex items-center justify-center min-h-[36px] px-4 rounded-full text-xs font-mono font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2',
                lang === 'en'
                  ? 'bg-zinc-100 text-zinc-950 font-semibold'
                  : 'text-zinc-300 hover:text-zinc-50',
              ]}
            >
              EN
            </a>
            <a
              href="/id/blog"
              data-lang-switch="id"
              aria-current={lang === 'id' ? 'page' : undefined}
              aria-label="ID - Bahasa Indonesia"
              class:list={[
                'inline-flex items-center justify-center min-h-[36px] px-4 rounded-full text-xs font-mono font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2',
                lang === 'id'
                  ? 'bg-zinc-100 text-zinc-950 font-semibold'
                  : 'text-zinc-300 hover:text-zinc-50',
              ]}
            >
              ID
            </a>
          </nav>

          <a
            href="/rss.xml"
            aria-label="RSS Feed"
            class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 hover:text-zinc-50 hover:border-zinc-700 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2"
          >
            <Icon name="ph:rss-simple" class="w-4 h-4 text-emerald-400" />
            <span>RSS</span>
          </a>
        </div>
      </div>

      <div class="divide-y divide-zinc-800/70 border-b border-zinc-800/70">
        {posts.map((post) => {
          const slug = getArticleSlug(post)
          const postHref = getBlogPath(lang, slug)
          return (
            <article class="group py-8 md:py-11 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-baseline transition-colors">
              <div class="md:col-span-3 flex flex-wrap md:flex-col items-center md:items-start gap-x-3 gap-y-1.5 text-sm font-mono tabular-nums text-zinc-400">
                <time datetime={post.data.publishedAt}>
                  {formatBlogDate(post.data.publishedAt, lang)}
                </time>
                <span class="md:hidden" aria-hidden="true">/</span>
                <span class="text-xs text-zinc-400">{post.data.readingTime}</span>
                <span class="hidden md:inline-flex items-center gap-2 pt-1 text-xs text-zinc-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
                  <span>{post.data.category}</span>
                </span>
              </div>

              <div class="md:col-span-7 space-y-3 min-w-0">
                <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100 leading-snug">
                  <a
                    href={postHref}
                    class="text-zinc-100 group-hover:text-emerald-400 hover:text-emerald-400 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-4 rounded-sm"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-[64ch]">
                  {post.data.description}
                </p>

                <ul class="flex flex-wrap gap-x-4 gap-y-1 pt-1 text-xs font-mono text-zinc-400" aria-label="Article tags">
                  {post.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>

              <div class="md:col-span-2 md:text-right pt-1 md:pt-0">
                <a
                  href={postHref}
                  aria-label={`${ui.readArticle}: ${post.data.title}`}
                  class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-medium text-emerald-400 hover:text-emerald-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-4 rounded-sm"
                >
                  <span>{ui.readArticle}</span>
                  <Icon
                    name="ph:arrow-up-right"
                    class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </a>
              </div>
            </article>
          )
        })}
      </div>

      <p class="mt-8 text-xs font-mono text-zinc-400 flex items-center gap-2">
        <Icon name="ph:globe-hemisphere-east" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>{ui.switchLangHint}</span>
      </p>
    </section>

    <ScrollTop />
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('[data-lang-switch]').forEach(function (link) {
    link.addEventListener('click', function () {
      var targetLang = link.getAttribute('data-lang-switch');
      if (targetLang) {
        document.cookie = 'blog_lang=' + targetLang + '; path=/; max-age=31536000; SameSite=Lax';
      }
    });
  });
</script>
