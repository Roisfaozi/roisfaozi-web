---
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import ScrollTop from './ScrollTop.astro'
import { profile, seoMeta } from '../data/profile'
import {
  BLOG_UI_COPY,
  formatBlogDate,
  getArticleSlug,
  getBlogPath,
  type BlogEntry,
  type BlogLang,
} from '../utils/blog'

interface Props {
  lang: BlogLang
  posts: BlogEntry[]
}

const { lang, posts } = Astro.props
const ui = BLOG_UI_COPY[lang]
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || seoMeta.siteUrl

const enBlogUrl = `${siteUrl}/blog`
const idBlogUrl = `${siteUrl}/id/blog`
const currentBlogUrl = lang === 'id' ? idBlogUrl : enBlogUrl

const alternates = [
  { hreflang: 'en', href: enBlogUrl },
  { hreflang: 'id', href: idBlogUrl },
  { hreflang: 'x-default', href: enBlogUrl },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Rois Faozi Portfolio',
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: profile.name,
      url: `${siteUrl}/`,
      image: seoMeta.ogImage,
      jobTitle: 'Full-Stack Developer (Go & TypeScript)',
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentBlogUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: currentBlogUrl,
        },
      ],
    },
    {
      '@type': 'Blog',
      '@id': `${currentBlogUrl}#blog`,
      url: currentBlogUrl,
      name: ui.pageTitle,
      description: ui.pageDescription,
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
       isPartOf: { '@id': `${siteUrl}/#website` },
      blogPost: posts.map((post) => {
        const slug = getArticleSlug(post)
        const postUrl = `${siteUrl}${getBlogPath(lang, slug)}`
        return {
          '@type': 'BlogPosting',
          '@id': `${postUrl}#article`,
          headline: post.data.title,
          description: post.data.description,
          url: postUrl,
          datePublished: post.data.publishedAt,
          dateModified: post.data.updatedAt || post.data.publishedAt,
          inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
          author: { '@id': `${siteUrl}/#person` },
          keywords: post.data.tags.join(', '),
        }
      }),
    },
  ],
}
---

<Layout
  title={ui.pageTitle}
  description={ui.pageDescription}
  lang={lang}
  ogType="website"
  alternates={alternates}
  customStructuredData={structuredData}
>
  <Navbar />

  <main id="main-content" class="flex-1 pt-28 md:pt-36 pb-24">
    <section class="max-w-5xl mx-auto px-6 md:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-zinc-800/80">
        <div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-50 leading-[1.08]">
            {ui.heading}
          </h1>
          <p class="mt-4 text-base sm:text-lg text-zinc-300 max-w-2xl leading-relaxed">
            {ui.subheading}
          </p>
        </div>

        <div class="flex items-center gap-3 self-start md:self-end shrink-0">
          <nav
            aria-label={ui.languageLabel}
            class="inline-flex items-center p-1 rounded-full bg-zinc-900 border border-zinc-800"
          >
            <a
              href="/blog"
              data-lang-switch="en"
              aria-current={lang === 'en' ? 'page' : undefined}
              aria-label="EN - English"
              class:list={[
                'px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-colors',
                lang === 'en'
                  ? 'bg-zinc-100 text-zinc-950 font-semibold'
                  : 'text-zinc-300 hover:text-zinc-50',
              ]}
            >
              EN
            </a>
            <a
              href="/id/blog"
              data-lang-switch="id"
              aria-current={lang === 'id' ? 'page' : undefined}
              aria-label="ID - Bahasa Indonesia"
              class:list={[
                'px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-colors',
                lang === 'id'
                  ? 'bg-zinc-100 text-zinc-950 font-semibold'
                  : 'text-zinc-300 hover:text-zinc-50',
              ]}
            >
              ID
            </a>
          </nav>

          <a
            href="/rss.xml"
            aria-label="RSS Feed"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 hover:text-zinc-50 hover:border-zinc-700 transition-colors"
          >
            <Icon name="ph:rss-simple" class="w-4 h-4 text-emerald-400" />
            <span>RSS</span>
          </a>
        </div>
      </div>

      <div class="mt-10 space-y-6">
        {posts.map((post) => {
          const slug = getArticleSlug(post)
          const postHref = getBlogPath(lang, slug)
          return (
            <article class="group rounded-2xl bg-zinc-900/50 border border-zinc-800/90 hover:border-zinc-700 p-6 sm:p-8 transition-colors">
              <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-400">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  {post.data.category}
                </span>
                <time datetime={post.data.publishedAt}>
                  {formatBlogDate(post.data.publishedAt, lang)}
                </time>
                <span aria-hidden="true">•</span>
                <span>{post.data.readingTime}</span>
              </div>

              <h2 class="mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-zinc-50 leading-snug">
                <a
                  href={postHref}
                  class="text-zinc-50 hover:text-emerald-400 transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>

              <p class="mt-3 text-base text-zinc-300 leading-relaxed max-w-3xl">
                {post.data.description}
              </p>

              {post.data.metrics.length > 0 && (
                <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 pt-5 border-t border-zinc-800/80">
                  {post.data.metrics.map((metric) => (
                    <div class="rounded-xl bg-zinc-950/70 border border-zinc-800/80 px-4 py-3">
                      <dt class="text-xs font-mono text-zinc-400">{metric.label}</dt>
                      <dd class="mt-1 text-lg font-bold font-mono text-emerald-400">
                        {metric.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              <div class="mt-6 pt-5 border-t border-zinc-800/70 flex flex-wrap items-center justify-between gap-4">
                <ul class="flex flex-wrap gap-2" aria-label="Article tags">
                  {post.data.tags.map((tag) => (
                    <li class="px-3 py-1 rounded-full bg-zinc-950 border border-zinc-800 text-xs font-mono text-zinc-300">
                      {tag}
                    </li>
                  ))}
                </ul>

                <a
                  href={postHref}
                  aria-label={`${ui.readArticle}: ${post.data.title}`}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
                >
                  <span>{ui.readArticle}</span>
                  <Icon name="ph:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
                </a>
              </div>
            </article>
          )
        })}
      </div>

      <p class="mt-10 text-xs font-mono text-zinc-400 flex items-center gap-2">
        <Icon name="ph:globe-hemisphere-east" class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>{ui.switchLangHint}</span>
      </p>
    </section>

    <ScrollTop />
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('[data-lang-switch]').forEach(function (link) {
    link.addEventListener('click', function () {
      var targetLang = link.getAttribute('data-lang-switch');
      if (targetLang) {
        document.cookie = 'blog_lang=' + targetLang + '; path=/; max-age=31536000; SameSite=Lax';
      }
    });
  });
</script>
