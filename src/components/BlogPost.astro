---
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import ScrollTop from './ScrollTop.astro'
import { profile, seoMeta } from '../data/profile'
import {
  BLOG_UI_COPY,
  formatBlogDate,
  getArticleSlug,
  getBlogPath,
  type BlogEntry,
  type BlogLang,
} from '../utils/blog'

interface Props {
  lang: BlogLang
  post: BlogEntry
  isFallback?: boolean
}

const { lang, post, isFallback = false } = Astro.props
const ui = BLOG_UI_COPY[lang]
const slug = getArticleSlug(post)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || seoMeta.siteUrl

const enPostPath = getBlogPath('en', slug)
const idPostPath = getBlogPath('id', slug)
const enPostUrl = `${siteUrl}${enPostPath}`
const idPostUrl = `${siteUrl}${idPostPath}`
const currentPostUrl = lang === 'id' ? idPostUrl : enPostUrl
const blogIndexPath = getBlogPath(lang)
const blogIndexUrl = `${siteUrl}${blogIndexPath}`
const otherLang: BlogLang = lang === 'id' ? 'en' : 'id'
const otherLangPath = lang === 'id' ? enPostPath : idPostPath

const postOgImage = post.data.ogImage
  ? new URL(post.data.ogImage, `${siteUrl}/`).href
  : `${siteUrl}/og/${lang}/${slug}.png`

const alternates = [
  { hreflang: 'en', href: enPostUrl },
  { hreflang: 'id', href: idPostUrl },
  { hreflang: 'x-default', href: enPostUrl },
]

const { Content, headings } = await post.render()
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const keywordsString =
  post.data.keywords.length > 0
    ? post.data.keywords.join(', ')
    : post.data.tags.join(', ')

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Rois Faozi Portfolio',
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: profile.name,
      url: `${siteUrl}/`,
      image: seoMeta.ogImage,
      jobTitle: 'Full-Stack Developer (Go & TypeScript)',
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentPostUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: blogIndexUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: currentPostUrl,
        },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${currentPostUrl}#article`,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': currentPostUrl,
      },
      headline: post.data.title,
      description: post.data.description,
      image: {
        '@type': 'ImageObject',
        url: postOgImage,
        width: 1200,
        height: 630,
      },
      datePublished: post.data.publishedAt,
      dateModified: post.data.updatedAt || post.data.publishedAt,
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      articleSection: post.data.category,
      keywords: keywordsString,
      timeRequired: `PT${post.data.readingMinutes}M`,
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      isPartOf: { '@id': `${blogIndexUrl}#blog` },
    },
  ],
}
---

<Layout
  title={`${post.data.title} | Rois Faozi`}
  description={post.data.description}
  lang={isFallback ? 'en' : lang}
  keywords={keywordsString}
  ogType="article"
  ogImage={postOgImage}
  ogImageAlt={post.data.title}
  alternates={alternates}
  articleMeta={{
    publishedTime: post.data.publishedAt,
    modifiedTime: post.data.updatedAt || post.data.publishedAt,
    tags: post.data.tags,
    section: post.data.category,
  }}
  customStructuredData={structuredData}
  noindex={isFallback}
>
  <Navbar />

  <main id="main-content" class="flex-1 pt-28 md:pt-36 pb-24">
    <article class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-zinc-800/80">
        <a
          href={blogIndexPath}
          class="inline-flex items-center gap-2 min-h-[44px] text-sm font-medium text-zinc-300 hover:text-zinc-50 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-4 rounded-sm"
        >
          <Icon name="ph:arrow-left" class="w-4 h-4 text-emerald-400" />
          <span>{ui.backToBlog}</span>
        </a>

        <nav
          aria-label={ui.languageLabel}
          class="inline-flex items-center p-1 rounded-full bg-zinc-900 border border-zinc-800"
        >
          <a
            href={enPostPath}
            data-lang-switch="en"
            aria-current={lang === 'en' ? 'page' : undefined}
            aria-label="EN - English"
            class:list={[
              'inline-flex items-center justify-center min-h-[36px] px-4 rounded-full text-xs font-mono font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2',
              lang === 'en'
                ? 'bg-zinc-100 text-zinc-950 font-semibold'
                : 'text-zinc-300 hover:text-zinc-50',
            ]}
          >
            EN
          </a>
          <a
            href={idPostPath}
            data-lang-switch="id"
            aria-current={lang === 'id' ? 'page' : undefined}
            aria-label="ID - Bahasa Indonesia"
            class:list={[
              'inline-flex items-center justify-center min-h-[36px] px-4 rounded-full text-xs font-mono font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2',
              lang === 'id'
                ? 'bg-zinc-100 text-zinc-950 font-semibold'
                : 'text-zinc-300 hover:text-zinc-50',
            ]}
          >
            ID
          </a>
        </nav>
      </div>

      {isFallback && ui.fallbackNotice && (
        <div class="mt-6 rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-300 max-w-4xl">
          {ui.fallbackNotice}
        </div>
      )}

      <header class="pt-10 pb-10 border-b border-zinc-800/80">
        <div class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono tabular-nums text-zinc-400">
            <span class="inline-flex items-center gap-2 text-zinc-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
              <span>{post.data.category}</span>
            </span>
            <span aria-hidden="true">/</span>
            <span>
              {ui.publishedLabel}{' '}
              <time datetime={post.data.publishedAt}>
                {formatBlogDate(post.data.publishedAt, lang)}
              </time>
            </span>
            <span aria-hidden="true">/</span>
            <span>{post.data.readingTime}</span>
          </div>

          <h1 class="mt-5 text-3xl sm:text-4xl lg:text-[2.85rem] font-bold tracking-tight text-zinc-50 leading-[1.12]">
            {post.data.title}
          </h1>

          <p class="mt-5 text-lg sm:text-xl text-zinc-300 leading-relaxed max-w-[66ch]">
            {post.data.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center font-mono text-xs font-semibold text-emerald-400">
                RF
              </div>
              <div>
                <p class="text-sm font-semibold text-zinc-100">{profile.name}</p>
                <p class="text-xs font-mono text-zinc-400">{ui.authorRole}</p>
              </div>
            </div>

            <a
              href={otherLangPath}
              data-lang-switch={otherLang}
              class="inline-flex items-center gap-2 min-h-[40px] px-4 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 hover:text-zinc-50 hover:border-zinc-700 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2"
            >
              <Icon name="ph:translate" class="w-4 h-4 text-emerald-400" />
              <span>{ui.readInOtherLang}</span>
            </a>
          </div>
        </div>
      </header>

      {tocItems.length > 0 && (
        <details class="lg:hidden mt-6 rounded-xl bg-zinc-900/50 border border-zinc-800 px-4 py-3">
          <summary class="flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden text-sm font-medium text-zinc-200 min-h-[36px]">
            <span>{ui.tocHeading}</span>
            <Icon name="ph:caret-down" class="w-4 h-4 text-zinc-400" />
          </summary>
          <nav aria-label={ui.tocHeading} class="mt-3 pt-3 border-t border-zinc-800/80">
            <ul class="space-y-2 text-sm">
              {tocItems.map((heading) => (
                <li class={heading.depth === 3 ? 'pl-4' : ''}>
                  <a
                    href={`#${heading.slug}`}
                    class="block py-1 text-zinc-400 hover:text-emerald-400 transition-colors"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}

      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] xl:grid-cols-[minmax(0,1fr)_260px] lg:gap-14 xl:gap-20 items-start pt-10 md:pt-12">
        <div class="min-w-0">
          <div class="blog-prose">
            <Content />
          </div>

          <footer class="mt-16 pt-10 border-t border-zinc-800/80 max-w-[74ch]">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono text-zinc-400 lg:hidden pb-8 border-b border-zinc-800/60 mb-8">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
              <div>
                <h2 class="text-xl font-semibold tracking-tight text-zinc-50">
                  {ui.ctaHeading}
                </h2>
                <p class="mt-2 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-[54ch]">
                  {ui.ctaBody}
                </p>
              </div>

              <a
                href="/#contact"
                class="inline-flex items-center justify-center gap-2 min-h-[44px] px-6 py-3 rounded-full bg-zinc-100 text-zinc-950 font-semibold text-sm hover:bg-zinc-200 transition-colors shrink-0 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2"
              >
                <span>{ui.ctaButton}</span>
                <Icon name="ph:arrow-up-right" class="w-4 h-4" />
              </a>
            </div>
          </footer>
        </div>

        <aside class="hidden lg:block lg:sticky lg:top-28 space-y-8">
          {tocItems.length > 0 && (
            <nav aria-label={ui.tocHeading}>
              <p class="text-xs font-mono font-medium text-zinc-200 mb-3">
                {ui.tocHeading}
              </p>
              <ul class="border-l border-zinc-800 pl-4 space-y-2.5 text-sm">
                {tocItems.map((heading) => (
                  <li class={heading.depth === 3 ? 'pl-3' : ''}>
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class="block text-zinc-400 hover:text-zinc-100 transition-colors leading-snug focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2 rounded-sm"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <div class="pt-6 border-t border-zinc-800/70">
            <p class="text-xs font-mono font-medium text-zinc-200 mb-3">
              {ui.topicsHeading}
            </p>
            <ul class="flex flex-wrap gap-x-3 gap-y-1.5 text-xs font-mono text-zinc-400">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>

          <div class="pt-6 border-t border-zinc-800/70">
            <button
              type="button"
              id="copy-article-link"
              data-copy-label={ui.copyLink}
              data-copied-label={ui.copied}
              class="inline-flex items-center gap-2 min-h-[40px] px-4 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 hover:text-zinc-50 hover:border-zinc-700 transition-colors active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-2"
            >
              <Icon name="ph:link-simple" class="w-4 h-4 text-emerald-400" />
              <span id="copy-article-label">{ui.copyLink}</span>
            </button>
          </div>
        </aside>
      </div>
    </article>

    <ScrollTop />
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('[data-lang-switch]').forEach(function (link) {
    link.addEventListener('click', function () {
      var targetLang = link.getAttribute('data-lang-switch');
      if (targetLang) {
        document.cookie = 'blog_lang=' + targetLang + '; path=/; max-age=31536000; SameSite=Lax';
      }
    });
  });

  var copyBtn = document.getElementById('copy-article-link');
  var copyLabel = document.getElementById('copy-article-label');
  if (copyBtn && copyLabel && navigator.clipboard) {
    copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(function () {
        var original = copyBtn.getAttribute('data-copy-label') || 'Copy link';
        var done = copyBtn.getAttribute('data-copied-label') || 'Copied';
        copyLabel.textContent = done;
        setTimeout(function () {
          copyLabel.textContent = original;
        }, 2000);
      });
    });
  }

  if ('IntersectionObserver' in window) {
    var tocLinks = document.querySelectorAll('[data-toc-link]');
    var headingEls = Array.prototype.slice
      .call(document.querySelectorAll('.blog-prose h2[id], .blog-prose h3[id]'));
    if (tocLinks.length > 0 && headingEls.length > 0) {
      var tocObs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var activeId = entry.target.getAttribute('id');
            tocLinks.forEach(function (a) {
              var matches = a.getAttribute('data-toc-link') === activeId;
              a.classList.toggle('text-emerald-400', matches);
              a.classList.toggle('text-zinc-400', !matches);
            });
          });
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: 0 },
      );
      headingEls.forEach(function (h) {
        tocObs.observe(h);
      });
    }
  }
</script>
