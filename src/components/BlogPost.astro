---
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import ScrollTop from './ScrollTop.astro'
import { profile, seoMeta } from '../data/profile'
import {
  BLOG_UI_COPY,
  formatBlogDate,
  getArticleSlug,
  getBlogPath,
  type BlogEntry,
  type BlogLang,
} from '../utils/blog'

interface Props {
  lang: BlogLang
  post: BlogEntry
  isFallback?: boolean
}

const { lang, post, isFallback = false } = Astro.props
const ui = BLOG_UI_COPY[lang]
const slug = getArticleSlug(post)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || seoMeta.siteUrl

const enPostPath = getBlogPath('en', slug)
const idPostPath = getBlogPath('id', slug)
const enPostUrl = `${siteUrl}${enPostPath}`
const idPostUrl = `${siteUrl}${idPostPath}`
const currentPostUrl = lang === 'id' ? idPostUrl : enPostUrl
const blogIndexPath = getBlogPath(lang)
const blogIndexUrl = `${siteUrl}${blogIndexPath}`
const otherLang: BlogLang = lang === 'id' ? 'en' : 'id'
const otherLangPath = lang === 'id' ? enPostPath : idPostPath

const alternates = [
  { hreflang: 'en', href: enPostUrl },
  { hreflang: 'id', href: idPostUrl },
  { hreflang: 'x-default', href: enPostUrl },
]

const { Content } = await post.render()
const keywordsString =
  post.data.keywords.length > 0
    ? post.data.keywords.join(', ')
    : post.data.tags.join(', ')

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'Rois Faozi Portfolio',
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: profile.name,
      url: `${siteUrl}/`,
      image: seoMeta.ogImage,
      jobTitle: 'Full-Stack Developer (Go & TypeScript)',
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentPostUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: blogIndexUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: currentPostUrl,
        },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${currentPostUrl}#article`,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': currentPostUrl,
      },
      headline: post.data.title,
      description: post.data.description,
      image: {
        '@type': 'ImageObject',
        url: seoMeta.ogImage,
        width: 1200,
        height: 630,
      },
      datePublished: post.data.publishedAt,
      dateModified: post.data.updatedAt || post.data.publishedAt,
      inLanguage: lang === 'id' ? 'id-ID' : 'en-US',
      articleSection: post.data.category,
      keywords: keywordsString,
      timeRequired: `PT${post.data.readingMinutes}M`,
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      isPartOf: { '@id': `${blogIndexUrl}#blog` },
    },
  ],
}
---

<Layout
  title={`${post.data.title} | Rois Faozi`}
  description={post.data.description}
  lang={isFallback ? 'en' : lang}
  keywords={keywordsString}
  ogType="article"
  alternates={alternates}
  articleMeta={{
    publishedTime: post.data.publishedAt,
    modifiedTime: post.data.updatedAt || post.data.publishedAt,
    tags: post.data.tags,
    section: post.data.category,
  }}
  customStructuredData={structuredData}
  noindex={isFallback}
>
  <Navbar />

  <main id="main-content" class="flex-1 pt-28 md:pt-36 pb-24">
    <article class="max-w-3xl mx-auto px-6 md:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-zinc-800/80">
        <a
          href={blogIndexPath}
          class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 hover:text-zinc-50 transition-colors"
        >
          <Icon name="ph:arrow-left" class="w-4 h-4 text-emerald-400" />
          <span>{ui.backToBlog}</span>
        </a>

        <nav
          aria-label={ui.languageLabel}
          class="inline-flex items-center p-1 rounded-full bg-zinc-900 border border-zinc-800"
        >
          <a
            href={enPostPath}
            data-lang-switch="en"
            aria-current={lang === 'en' ? 'page' : undefined}
            aria-label="EN - English"
            class:list={[
              'px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-colors',
              lang === 'en'
                ? 'bg-zinc-100 text-zinc-950 font-semibold'
                : 'text-zinc-300 hover:text-zinc-50',
            ]}
          >
            EN
          </a>
          <a
            href={idPostPath}
            data-lang-switch="id"
            aria-current={lang === 'id' ? 'page' : undefined}
            aria-label="ID - Bahasa Indonesia"
            class:list={[
              'px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-colors',
              lang === 'id'
                ? 'bg-zinc-100 text-zinc-950 font-semibold'
                : 'text-zinc-300 hover:text-zinc-50',
            ]}
          >
            ID
          </a>
        </nav>
      </div>

      {isFallback && ui.fallbackNotice && (
        <div class="mt-6 rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-300">
          {ui.fallbackNotice}
        </div>
      )}

      <header class="mt-8 pb-8 border-b border-zinc-800/80">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-400">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            {post.data.category}
          </span>
          <span>
            {ui.publishedLabel}{' '}
            <time datetime={post.data.publishedAt}>
              {formatBlogDate(post.data.publishedAt, lang)}
            </time>
          </span>
          <span aria-hidden="true">•</span>
          <span>{post.data.readingTime}</span>
        </div>

        <h1 class="mt-5 text-3xl sm:text-4xl md:text-[2.75rem] font-bold tracking-tight text-zinc-50 leading-[1.12]">
          {post.data.title}
        </h1>

        <p class="mt-5 text-lg text-zinc-300 leading-relaxed">
          {post.data.description}
        </p>

        {post.data.metrics.length > 0 && (
          <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
            {post.data.metrics.map((metric) => (
              <div class="rounded-xl bg-zinc-900/70 border border-zinc-800 px-4 py-3.5">
                <dt class="text-xs font-mono text-zinc-400">{metric.label}</dt>
                <dd class="mt-1 text-lg sm:text-xl font-bold font-mono text-emerald-400">
                  {metric.value}
                </dd>
              </div>
            ))}
          </dl>
        )}

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-zinc-800/60">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center font-mono text-sm font-bold text-emerald-400">
              RF
            </div>
            <div>
              <p class="text-sm font-semibold text-zinc-100">{profile.name}</p>
              <p class="text-xs font-mono text-zinc-400">{ui.authorRole}</p>
            </div>
          </div>

          <a
            href={otherLangPath}
            data-lang-switch={otherLang}
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 hover:text-zinc-50 hover:border-zinc-700 transition-colors"
          >
            <Icon name="ph:translate" class="w-4 h-4 text-emerald-400" />
            <span>{ui.readInOtherLang}</span>
          </a>
        </div>
      </header>

      <div class="blog-prose mt-10">
        <Content />
      </div>

      <footer class="mt-14 pt-8 border-t border-zinc-800">
        <div class="flex flex-wrap gap-2" aria-label="Article tags">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300">
              {tag}
            </span>
          ))}
        </div>

        <div class="mt-8 rounded-2xl bg-zinc-900/60 border border-zinc-800 p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div>
              <h2 class="text-xl font-bold tracking-tight text-zinc-50">
                {ui.ctaHeading}
              </h2>
              <p class="mt-2 text-sm text-zinc-300 leading-relaxed max-w-xl">
                {ui.ctaBody}
              </p>
            </div>

            <a
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-zinc-100 text-zinc-950 font-semibold text-sm hover:bg-white transition-colors shrink-0 active:scale-[0.98]"
            >
              <span>{ui.ctaButton}</span>
              <Icon name="ph:arrow-up-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </footer>
    </article>

    <ScrollTop />
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('[data-lang-switch]').forEach(function (link) {
    link.addEventListener('click', function () {
      var targetLang = link.getAttribute('data-lang-switch');
      if (targetLang) {
        document.cookie = 'blog_lang=' + targetLang + '; path=/; max-age=31536000; SameSite=Lax';
      }
    });
  });
</script>
