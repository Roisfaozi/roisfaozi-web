---
import { Icon } from 'astro-icon/components'

const links = [
  ['Home', '#home'],
  ['About', '#about'],
  ['Project', '#project'],
  ['Contact', '#contact'],
]
---
<header class="fixed top-0 left-0 w-full py-4 md:py-5 z-50 pointer-events-none">
  <div class="max-w-7xl mx-auto px-6 md:px-12 pointer-events-auto">
    <div class="relative flex items-center justify-between">
      <div>
        <a href="/" aria-label="home" class="block text-zinc-100 hover:text-zinc-300 transition-colors">
          <svg width="73" height="32" viewBox="0 0 73 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.72 28.7L0.16 18.14L10.72 7.58L14.02 10.858L6.496 18.14L14.02 25.422L10.72 28.7ZM62.4135 28.7L59.1355 25.422L66.6375 18.14L59.1355 10.858L62.4135 7.58L72.9955 18.14L62.4135 28.7Z" fill="#8B8B93" />
            <path d="M25.1386 32V0.319999H38.2286C38.5366 0.319999 38.9326 0.334665 39.4166 0.363998C39.9006 0.378666 40.3479 0.422666 40.7586 0.495999C42.5919 0.774665 44.1026 1.38333 45.2906 2.322C46.4933 3.26066 47.3806 4.44867 47.9526 5.886C48.5393 7.30867 48.8326 8.89267 48.8326 10.638C48.8326 13.2193 48.1799 15.4413 46.8746 17.304C45.5693 19.152 43.5673 20.296 40.8686 20.736L38.6026 20.934H30.4406V32H25.1386ZM43.3326 32L37.0846 19.108L42.4746 17.92L49.3386 32H43.3326ZM30.4406 15.984H38.0086C38.3019 15.984 38.6319 15.9693 38.9986 15.94C39.3653 15.9107 39.7026 15.852 40.0106 15.764C40.8906 15.544 41.5799 15.1553 42.0786 14.598C42.5919 14.0407 42.9513 13.41 43.1566 12.706C43.3766 12.002 43.4866 11.3127 43.4866 10.638C43.4866 9.96333 43.3766 9.274 43.1566 8.57C42.9513 7.85133 42.5919 7.21333 42.0786 6.656C41.5799 6.09867 40.8906 5.71 40.0106 5.49C39.7026 5.402 39.3653 5.35067 38.9986 5.336C38.6319 5.30667 38.3019 5.292 38.0086 5.292H30.4406V15.984Z" fill="currentColor" />
          </svg>
        </a>
      </div>

      <nav class="hidden 2md:block" aria-label="Primary navigation">
        <ul class="flex gap-8 items-center bg-zinc-900/75 backdrop-blur-md px-6 py-2.5 rounded-full border border-zinc-800/70">
          {links.map(([label, href]) => (
            <li>
              <a href={href} class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition-colors whitespace-nowrap">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="2md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-zinc-900/80 backdrop-blur-md border border-zinc-800 text-zinc-200 hover:text-zinc-50 hover:border-zinc-700 transition-colors active:scale-[0.98]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="ph:list" class="w-5 h-5" id="menu-icon-open" />
        <Icon name="ph:x" class="w-5 h-5 hidden" id="menu-icon-close" />
      </button>
    </div>

    <nav
      id="mobile-nav"
      aria-label="Mobile navigation"
      class="hidden 2md:hidden mt-3 rounded-2xl bg-zinc-950/95 backdrop-blur-md border border-zinc-800 p-4"
    >
      <ul class="flex flex-col gap-1">
        {links.map(([label, href]) => (
          <li>
            <a
              href={href}
              class="mobile-nav-link block px-4 py-2.5 rounded-xl text-sm font-medium text-zinc-300 hover:text-zinc-50 hover:bg-zinc-900 transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle')
  const mobileNav = document.getElementById('mobile-nav')
  const iconOpen = document.getElementById('menu-icon-open')
  const iconClose = document.getElementById('menu-icon-close')
  const mobileLinks = document.querySelectorAll('.mobile-nav-link')

  function setMenuOpen(open: boolean) {
    if (!toggleBtn || !mobileNav || !iconOpen || !iconClose) return
    mobileNav.classList.toggle('hidden', !open)
    toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false')
    iconOpen.classList.toggle('hidden', open)
    iconClose.classList.toggle('hidden', !open)
  }

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true'
    setMenuOpen(!isExpanded)
  })

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false))
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false)
      toggleBtn.focus()
    }
  })
</script>
