---
import BlogPost from '../../components/BlogPost.astro'
import { getArticleSlug, getPublishedBlogPosts, type BlogEntry } from '../../utils/blog'

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts('en')
  return posts.map((post) => ({
    params: { slug: getArticleSlug(post) },
    props: { post },
  }))
}

interface Props {
  post: BlogEntry
}

const { post } = Astro.props
---

<BlogPost lang="en" post={post} />
